# Настройка AI-ассистента (assistant.py). Пайплайн run.py этих переменных не требует.
# Скопируйте в .env или экспортируйте в оболочке: set -a; source .env; set +a

# Адрес OpenAI-compatible Chat Completions API. Обязателен: без него ассистент
# работает офлайн и никуда данные не отправляет.
# Примеры: Ollama — http://127.0.0.1:11434/v1, LM Studio — http://127.0.0.1:1234/v1
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Имя модели на вашем endpoint (обязательно), например qwen2.5:14b или llama3.1:8b
OPENAI_MODEL=qwen2.5:14b

# Токен нужен только если внутренний шлюз требует авторизацию; для локальных
# серверов оставьте пустым или удалите строку.
# OPENAI_API_KEY=
